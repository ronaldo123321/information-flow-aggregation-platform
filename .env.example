# Copy this file to .env and fill in your own credentials.
# Never commit the populated .env file.

DEEPSEEK_API_KEY=

# 日报摘要卡片推送的群 Webhook（未填时回退到旧变量名 LARK_RSS_WEBHOOK）
LARK_DAILY_WEBHOOK=
# 晚间 X 观点增量卡推送的群 Webhook
LARK_X_WEBHOOK=

# 报告对外访问地址（本地服务托管时用），如 http://1.2.3.4:8080
REPORT_BASE_URL=

# 配置后报告自动上传到 GCS bucket（公开读取），卡片按钮指向公网地址
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
# 服务账号 key：文件路径或 JSON 原文（二选一，本机开发也可不填、直接用 gcloud 默认凭据）
GCS_KEY_FILE=
GCS_CONFIG_JSON=

# Required only for the Product Hunt job.
PRODUCTHUNT_TOKEN=
